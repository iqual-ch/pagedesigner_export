<?php

/**
 * @file
 * Owns the MCP service account (role + passwordless user) and the OAuth 2.1
 * client_credentials client the migration agent authenticates with on the
 * SOURCE site.
 */

declare(strict_types=1);

use Drupal\Core\File\FileSystemInterface;
use Drupal\user\Entity\Role;
use Drupal\user\Entity\User;

/**
 * Machine name of the service role, user, scope and consumer this module owns.
 */
const PAGEDESIGNER_MCP_SERVICE_ACCOUNT = 'pagedesigner_mcp';

/**
 * Ensure the MCP service role and passwordless user exist with the grants.
 *
 * OAuth 2.1 access tokens (client_credentials, see
 * pagedesigner_mcp_ensure_oauth_client()) act as this user; the token's
 * permission ceiling is the role via the pagedesigner_mcp scope. Same
 * lifecycle as icms_mcp on targets: the module is enabled per site only
 * during its migration window. The role is a config entity: run `drush cex`
 * after install or the next config import deletes it.
 */
function pagedesigner_mcp_ensure_service_account(): void {
  $role = Role::load(PAGEDESIGNER_MCP_SERVICE_ACCOUNT);
  if ($role === NULL) {
    $role = Role::create([
      'id' => PAGEDESIGNER_MCP_SERVICE_ACCOUNT,
      'label' => 'Pagedesigner MCP',
    ]);
  }
  // `access mcp server` gates the mcp_server endpoint (primary transport);
  // `use mcp server` keeps the legacy drupal/mcp endpoint working during
  // the transition window; `use pagedesigner_mcp tools` is our own gate.
  foreach (['access mcp server', 'use mcp server', 'use pagedesigner_mcp tools'] as $permission) {
    $role->grantPermission($permission);
  }
  $role->save();

  $existing = \Drupal::entityTypeManager()->getStorage('user')
    ->loadByProperties(['name' => PAGEDESIGNER_MCP_SERVICE_ACCOUNT]);
  if ($existing) {
    /** @var \Drupal\user\UserInterface $user */
    $user = reset($existing);
    if (!$user->hasRole(PAGEDESIGNER_MCP_SERVICE_ACCOUNT)) {
      $user->addRole(PAGEDESIGNER_MCP_SERVICE_ACCOUNT);
      $user->save();
    }
    return;
  }

  // No password: the account exists only as the identity OAuth tokens map
  // to. Nothing can log in as it.
  User::create([
    'name' => PAGEDESIGNER_MCP_SERVICE_ACCOUNT,
    'status' => 1,
    'roles' => [PAGEDESIGNER_MCP_SERVICE_ACCOUNT],
  ])->save();
  \Drupal::logger('pagedesigner_mcp')->notice('Created the @name service user and role. Export config (drush cex) so the next config import keeps the role.', [
    '@name' => PAGEDESIGNER_MCP_SERVICE_ACCOUNT,
  ]);
}

/**
 * Remove the MCP service user, role, OAuth consumer and scope on uninstall.
 *
 * The export exposes everything including unpublished content — uninstall
 * must leave no standing credential behind. The simple_oauth key pair is
 * left in place; other consumers may rely on it.
 */
function pagedesigner_mcp_remove_service_account(): void {
  $etm = \Drupal::entityTypeManager();
  if ($etm->hasDefinition('consumer')) {
    foreach ($etm->getStorage('consumer')->loadByProperties(['client_id' => PAGEDESIGNER_MCP_SERVICE_ACCOUNT]) as $consumer) {
      $consumer->delete();
    }
  }
  if ($etm->hasDefinition('oauth2_scope')) {
    $etm->getStorage('oauth2_scope')->load(PAGEDESIGNER_MCP_SERVICE_ACCOUNT)?->delete();
  }
  $users = $etm->getStorage('user')
    ->loadByProperties(['name' => PAGEDESIGNER_MCP_SERVICE_ACCOUNT]);
  foreach ($users as $user) {
    $user->delete();
  }
  Role::load(PAGEDESIGNER_MCP_SERVICE_ACCOUNT)?->delete();
}

/**
 * Where the simple_oauth signing keys are generated (a stream URI, see below).
 */
const PAGEDESIGNER_MCP_KEY_DIR = 'private://simple_oauth';

/**
 * Provision the OAuth 2.1 client_credentials client for the MCP tools.
 *
 * Owns the full chain so per-site setup stays "enable the module":
 * simple_oauth key pair under private:// (never served, never in git), a
 * `pagedesigner_mcp` scope with ROLE granularity, and a confidential
 * Consumer (client_credentials grant, 1h tokens) bound to the passwordless
 * service user.
 *
 * @return array{client_id: string, client_secret: string}|null
 *   The credentials when the consumer was newly created — shown exactly
 *   once, paste them into the cockpit connection form. NULL when the
 *   consumer already existed (secret untouched; rotate with
 *   `drush pagedesigner-mcp:rotate-secret`).
 */
function pagedesigner_mcp_ensure_oauth_client(): ?array {
  $etm = \Drupal::entityTypeManager();

  // 1. Signing keys, in the private file system. That is the one location
  // that is writable on every host (Upsun mount, DDEV, plain LAMP), never
  // served, and never under git — `<project>/keys` was inside the repository
  // and got committed. Stored as a stream URI so the exported
  // simple_oauth.settings is valid in every environment; simple_oauth
  // resolves it through the file system's realpath().
  $settings = \Drupal::configFactory()->getEditable('simple_oauth.settings');
  $public = (string) $settings->get('public_key');
  $private = (string) $settings->get('private_key');
  if ($public === '' || $private === '' || !is_file($public) || !is_file($private)) {
    $dir = PAGEDESIGNER_MCP_KEY_DIR;
    $file_system = \Drupal::service('file_system');
    if ($file_system->realpath('private://') === FALSE) {
      // hook_requirements() blocks a fresh install before this point; the
      // update-hook path has no such gate, so refuse here rather than
      // generate the keys somewhere they do not belong.
      throw new \RuntimeException(
        "pagedesigner_mcp: no private file system is configured, so the OAuth signing keys have nowhere safe to live. Set \$settings['file_private_path'] to a writable directory outside the webroot and run this again."
      );
    }
    if (!$file_system->prepareDirectory($dir, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS)) {
      throw new \RuntimeException("pagedesigner_mcp: could not create $dir for the OAuth signing keys.");
    }
    if (!is_file($dir . '/public.key') || !is_file($dir . '/private.key')) {
      \Drupal::service('simple_oauth.key.generator')->generateKeys($dir);
    }
    $settings
      ->set('public_key', $dir . '/public.key')
      ->set('private_key', $dir . '/private.key')
      ->save();
  }

  // 2. Scope: role granularity — the token's permission ceiling is the role.
  $scope_storage = $etm->getStorage('oauth2_scope');
  if ($scope_storage->load(PAGEDESIGNER_MCP_SERVICE_ACCOUNT) === NULL) {
    $scope_storage->create([
      'id' => PAGEDESIGNER_MCP_SERVICE_ACCOUNT,
      'name' => PAGEDESIGNER_MCP_SERVICE_ACCOUNT,
      'description' => 'Pagedesigner MCP migration export tools',
      'grant_types' => ['client_credentials' => ['status' => TRUE]],
      'umbrella' => FALSE,
      'granularity_id' => 'role',
      'granularity_configuration' => ['role' => PAGEDESIGNER_MCP_SERVICE_ACCOUNT],
    ])->save();
  }

  // 3. Consumer. Existing consumer keeps its secret.
  $consumer_storage = $etm->getStorage('consumer');
  if ($consumer_storage->loadByProperties(['client_id' => PAGEDESIGNER_MCP_SERVICE_ACCOUNT])) {
    return NULL;
  }
  $users = $etm->getStorage('user')->loadByProperties(['name' => PAGEDESIGNER_MCP_SERVICE_ACCOUNT]);
  $user = reset($users);
  $secret = \Drupal::service('password_generator')->generate(32);
  $consumer_storage->create([
    'label' => 'Pagedesigner MCP',
    'client_id' => PAGEDESIGNER_MCP_SERVICE_ACCOUNT,
    'secret' => $secret,
    'confidential' => TRUE,
    'grant_types' => [['value' => 'client_credentials']],
    'user_id' => $user ? $user->id() : NULL,
    'scopes' => [['scope_id' => PAGEDESIGNER_MCP_SERVICE_ACCOUNT]],
    'access_token_expiration' => 3600,
    'is_default' => FALSE,
  ])->save();
  \Drupal::logger('pagedesigner_mcp')->notice('Created the @id OAuth consumer (client_credentials). Export config (drush cex) so the consumer, scope, and role survive the next config import.', [
    '@id' => PAGEDESIGNER_MCP_SERVICE_ACCOUNT,
  ]);
  return ['client_id' => PAGEDESIGNER_MCP_SERVICE_ACCOUNT, 'client_secret' => $secret];
}
